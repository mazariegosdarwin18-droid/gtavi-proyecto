---
import Layout from '@/layouts/Layout.astro';
import HeroKeyLogo from '@/assets/hero-key-logo.webp';
import HeroKeyBackground from '@/assets/hero-key-background.webp';
import LogoVIIcon from '@/assets/logo-vi.svg';
import PlayButtonIcon from '@/assets/play-button.svg';
import LogoCutted from '@/assets/logo-cutted.svg';
---

<Layout>
    <div id="logo-mask" class="fixed top-0 w-full h-screen">
    <section>
        <picture 
            id="hero-key"
            class="h-screen scale-125 block overflow-hidden fixed"
        >
            <img 
                id="hero-key-logo"
                src={HeroKeyLogo.src}
                class="absolute w-full h-full object-cover"
            />
            <img 
                id="hero-key-background"
                src={HeroKeyBackground.src}
                class="w-full h-full object-cover"
            />
        </picture>  
    </section>
    </div>   

    <div 
        class="fixed flex flex-col items-center justify-between h-screen px-20 pt-16 w-full"
    >
        <header class="flex justify-between w-full">
            <LogoVIIcon 
                class="size-11 text-white hover:text-yellow-100 transition-colors duration-500 cursor-pointer" />
        </header>

    
        <button class="absolute inset-0 m-auto cursor-pointer inline-block">
            <PlayButtonIcon 
                id="hero-play-button"
                class="text-white m-auto size-32 nt-10 backdrop-blur-3xl rounded-full hover:scale-110 transition-transform duration-500"
            />
        </button>

       <footer id="hero-footer" class="flex flex-col items-center justify-center gap-1 pb-18 pointer-events-auto">
    <span class="text-white text-[10px] tracking-[0.25em] uppercase opacity-80 font-semibold select-none">
      Ver el tráiler
    </span>
    <LogoCutted class="w-30 h-auto text-white mt-1" />
  </footer>
    </div> 
</Layout>

<style>
    #logo-mask {
        background: white;
        mask-image: url("/logo-stack.svg");
        mask-size: cover;
        mask-position: center 25%;
        mask-repeat: no-repeat;
        mask-size: clamp(5350vh, 3000%, 0vh);
    }
</style>

<script>
    import { gsap} from "gsap"
    import { ScrollTrigger } from "gsap/ScrollTrigger"

    gsap.registerPlugin(ScrollTrigger)

    const tl = gsap.timeline({
        scrollTrigger: {
            scrub: 1
        }
    })

        .to("#hero-key-logo", { opacity: 0}, "<")
        .to("#hero-footer", { opacity: 0}, "<")
        .to("#hero-play-button", { opacity: 0}, "<")
        .to(   
            "#logo-mask", {
            maskSize : "clamp(20vh, 20%, 30vh)"
            },
            0.15
        )
        .to(
            "#hero-key", {
            opacity: 0, 
            duration: 0.2
            },
            0.4 
        )
</script>
